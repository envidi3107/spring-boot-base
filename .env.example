# Copy thành .env rồi chỉnh. File .env được cả Spring Boot và docker compose đọc.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL
DB_NAME=hrms
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/hrms
DB_USERNAME=hrms
DB_PASSWORD=hrms
# Schema do Flyway quản lý (src/main/resources/db/migration). validate | none
JPA_DDL_AUTO=validate
# true khi DB đã có bảng nhưng chưa có lịch sử Flyway (bỏ qua V1, đánh dấu baseline)
FLYWAY_BASELINE_ON_MIGRATE=false

# JWT - sinh secret bằng: openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Tài khoản admin tạo lúc khởi động nếu chưa có (bỏ trống ADMIN_PASSWORD để không tạo)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
